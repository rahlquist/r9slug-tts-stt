FROM python:3.12-slim
ARG ORT_EXTRA=cpu
ENV PIP_NO_CACHE_DIR=1 OMP_NUM_THREADS=6 HF_HOME=/models/hf
RUN pip install "onnx-asr[${ORT_EXTRA},hub]==0.12.0" fastapi uvicorn soundfile python-multipart
COPY scripts/parakeet_prewarm.py /prewarm.py
RUN python /prewarm.py
COPY scripts/stt_service.py /serve.py
EXPOSE 8094
CMD ["uvicorn", "serve:app", "--host", "0.0.0.0", "--port", "8094", "--workers", "1", "--no-access-log"]
